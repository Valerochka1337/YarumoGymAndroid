<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Update: без него уведомление тренировки не попадёт в чип статус-бара (и в Fluid
         Cloud на OxygenOS). Не runtime; появилось в 36.1, на 36.0 просто игнорируется. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Внешние пакеты и системные обработчики, которые приложение должно уметь разрешать. -->
    <queries>
        <package android:name="com.mi.health" />
        <package android:name="com.xiaomi.wearable" />
    </queries>

    <application
        android:name=".GymApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ValerochkaGym"
        android:usesCleartextTraffic="true">

        <!-- Запускается не напрямую, а через один из activity-alias ниже: иконку в лаунчере
             выбирает пользователь (акцент), а сменить её можно только включением/выключением
             компонентов. Поэтому здесь нет intent-filter и exported="false". -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.ValerochkaGym" />

        <activity
            android:name=".ui.routineshare.RoutineShareLinkActivity"
            android:exported="true"
            android:theme="@style/Theme.ValerochkaGym">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="api.valerochkagym.tech"
                    android:pathPrefix="/r/" />
            </intent-filter>
        </activity>

        <!-- Temporary URI for TakePicture. The InBody image stays in cache only while it is read. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.inbody-import"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/inbody_import_paths" />
        </provider>

        <!-- Явный callback PackageInstaller.Session. Не экспортируется; система вызывает его
             только через созданный приложением mutable PendingIntent. -->
        <receiver
            android:name=".data.update.AppUpdateInstallStatusReceiver"
            android:exported="false" />

        <!-- Системный broadcast после замены собственного APK. Не запускает Activity: только
             сохраняет pending-маркер и публикует notification для явного тапа пользователя. -->
        <receiver
            android:name=".data.update.AppUpdateReplacementReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Иконки под акценты. Включён ровно один; переключает AppIconManager по настройке.
             Порядок и имена связаны с AccentColor.aliasName — менять только вместе. -->
        <activity-alias
            android:name=".MainActivityGreen"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLime"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lime"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_lime"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityCyan"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyan"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_cyan"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityCoral"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_coral"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_coral"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.WorkoutSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse|connectedDevice">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="workout_session_tracking" />
        </service>

        <!-- Отключаем дефолтную инициализацию WorkManager: конфигурация с HiltWorkerFactory
             приходит из GymApplication (Configuration.Provider). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
